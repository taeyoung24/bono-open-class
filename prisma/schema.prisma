generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. 학생 테이블
model Student {
  id         Int            @id @default(autoincrement())
  name       String         // 이름 (예: 김철수)
  secretCode String         // 아이들용 암호 (예: "피카츄", "1234" 등)
  badges     StudentBadge[]
}

// 2. 뱃지 메타데이터 테이블
model Badge {
  id          Int            @id @default(autoincrement())
  name        String         // 뱃지 이름 (예: "첫 타자왕")
  description String?        // 뱃지 설명
  imagePath   String         // 이미지 경로 (예: "/badges/type-master.svg")
  grade       Int            @default(1) // 1~5 자연수 등급 (1이 가장 낮고 5가 가장 높음)
  students    StudentBadge[]
}

// 3. 학생-뱃지 발급 기록 (N:M 매핑)
model StudentBadge {
  id        String   @id @default(uuid()) // 아이들이 열광할 고유 해커 식별자!
  studentId Int
  badgeId   Int
  earnedAt  DateTime @default(now())      // 획득 시간 자동 기록
  issuer    String   @default("정태영")    // 발급자 기본값 세팅

  student   Student  @relation(fields: [studentId], references: [id])
  badge     Badge    @relation(fields: [badgeId], references: [id])

  // 한 학생이 똑같은 뱃지를 두 번 받지 않도록 방지 (원치 않으시면 지워도 됩니다)
  @@unique([studentId, badgeId]) 
}