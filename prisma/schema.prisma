generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// 사용자 계정 (인증 및 권한 관리)
// ─────────────────────────────────────────────
model User {
  id           Int      @id @default(autoincrement())
  userId       String   @unique // 로그인 시 사용하는 아이디
  email        String   @unique // 사용자 이메일 (아이디@도메인)
  password     String   // 해싱된 비밀번호
  refreshToken String?  // JWT Refresh Token 보관용 (선택 사항)
  
  // 기본 프로필 정보
  name         String?  // 사용자 이름
  role         String   @default("STUDENT") // ADMIN | STUDENT | TEACHER
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 메일 관련 관계
  sentMails     Mail[] @relation("SentMails")
  receivedMails Mail[] @relation("ReceivedMails")

  @@map("users") // 테이블 이름을 명확하게 지정
}

// ─────────────────────────────────────────────
// 메일(쪽지) 시스템
// ─────────────────────────────────────────────
model Mail {
  id          Int      @id @default(autoincrement())
  
  // 발신자 정보
  sender      User     @relation("SentMails", fields: [senderId], references: [userId])
  senderId    String
  
  // 수신자 정보
  receiver    User     @relation("ReceivedMails", fields: [receiverId], references: [userId])
  receiverId  String
  
  title       String   // 제목
  content     String   // 내용
  
  isRead      Boolean  @default(false) // 읽음 여부
  
  createdAt   DateTime @default(now())   // 보낸 시간

  @@map("mails")
}

// ─────────────────────────────────────────────
// 비밀번호 재설정 인증코드 (임시 저장, 10분 유효)
// ─────────────────────────────────────────────
model PasswordResetCode {
  id        Int      @id @default(autoincrement())
  userId    String   @unique // 한 아이디에 하나의 코드만 유효
  code      String   // 4자리 숫자 코드
  expiresAt DateTime // 만료 시각 (발급 후 10분)
  createdAt DateTime @default(now())

  @@map("password_reset_codes")
}