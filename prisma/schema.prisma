generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// 사용자 계정 (인증 및 권한 관리)
// ─────────────────────────────────────────────
model User {
  id           Int      @id @default(autoincrement())
  userId       String   @unique // 로그인 시 사용하는 아이디
  password     String   // 해싱된 비밀번호
  refreshToken String?  // JWT Refresh Token 보관용 (선택 사항)
  
  // 기본 프로필 정보
  name         String?  // 사용자 이름
  role         String   @default("STUDENT") // ADMIN | STUDENT | TEACHER
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users") // 테이블 이름을 명확하게 지정
}